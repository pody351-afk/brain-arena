# بيتشغّل من GitHub Actions (ios-release). بيعمل الشهادة وملف التوقيع من خلال App Store Connect API، ويبني ويرفع لـ TestFlight.
default_platform(:ios)

platform :ios do
  lane :release do
    setup_ci
    kc = File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db")
    # Apple WWDR G3 intermediate certificate, needed so the distribution certificate is recognized
    sh("curl -sSL -o /tmp/AppleWWDRCAG3.cer https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer && security import /tmp/AppleWWDRCAG3.cer -k #{kc} -T /usr/bin/codesign -T /usr/bin/security || true")
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      in_house: false
    )
    bid = ENV["BUNDLE_ID"]
    team = ENV["APPLE_TEAM_ID"]

    get_certificates(api_key: api_key, output_path: "build/certs", keychain_path: kc, keychain_password: "")
    get_provisioning_profile(api_key: api_key, app_identifier: bid, output_path: "build/profiles", force: true)

    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: team,
      targets: ["App"],
      bundle_identifier: bid,
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']} MARKETING_VERSION=1.6"
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
